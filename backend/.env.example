# 复制本文件为 .env 并填入真实配置：cp .env.example .env

# ---- LLM (OpenAI-compatible) ----
# DeepSeek 官方: https://api.deepseek.com/v1 ，模型 deepseek-v4-pro / deepseek-flash
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-v4-pro
LLM_THINKING=false           # 思考模式：开启后回答更深但首字变慢、token 更多

# ---- Embedding ----
EMBEDDING_API_URL=https://your-embedding-endpoint/v1
EMBEDDING_API_KEY=sk-your-key
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---- PostgreSQL (docker compose 中的 pgvector 镜像) ----
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/anan_agent

# ---- External services（docker compose 统一管理） ----
# RapidOCRAPI，API 文档: http://localhost:9003/docs
OCR_API_URL=http://localhost:9003/ocr
# TikTokDownloader Web API 模式，API 文档: http://localhost:5555/docs
DOUYIN_API_URL=http://localhost:5555

# ---- ASR (faster-whisper，本地运行，无 GPU 也可) ----
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto        # auto / cpu / cuda
WHISPER_COMPUTE_TYPE=int8  # cpu 推荐 int8, cuda 推荐 float16

# ---- Pipeline ----
DATA_DIR=./data            # 视频/音频文件存储目录
TOP_COMMENTS=20            # 每条视频保留的高赞评论数
CLASSIFY_CONFIDENCE_THRESHOLD=0.7

# ---- Auth ----
# 生产环境务必修改；首次启动会自动创建超管 admin / 123456
SECRET_KEY=anan-agent-dev-secret-please-change

# ============================================================
# 生产部署（后端也进 docker-compose）时，改用服务名替换上面三处地址：
# DATABASE_URL=postgresql+psycopg2://postgres:123456@postgres:5432/anan_agent
# OCR_API_URL=http://rapidocr:9003/ocr
# DOUYIN_API_URL=http://tiktok-downloader:5555
# ============================================================
